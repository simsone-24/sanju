PORT=5000
APP_NAME=Event Management ERP

DATABASE_URL="mysql://root:@127.0.0.1:3307/sanju"

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_PATH=uploads

# Comma-separated list of browser origins allowed to call this API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://sanju-psi.vercel.app

# Used only by prisma/seed.ts to bootstrap the first company + Super Admin login.
# Sign-in is by username (masters/user.md §Login Credentials); the email is optional.
SEED_COMPANY_NAME=
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_MOBILE=
SEED_ADMIN_EMAIL=
